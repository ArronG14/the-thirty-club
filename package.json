{
  "name": "the-thirty-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pwa": "npm run build && playwright test",
    "test:webkit": "npm run build && playwright test -c playwright.webkit.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "capture:casino": "VITE_CASINO_LOOKDEV=1 vite build --outDir dist-lookdev && playwright test -c playwright.casino.config.ts",
    "test:office": "npm run build && playwright test -c playwright.office.config.ts",
    "test:correspondence": "npm run build && playwright test -c playwright.correspondence.config.ts",
    "test:butler": "npm run build && playwright test -c playwright.butler.config.ts",
    "functions:build": "npx --yes netlify-cli@27.13.0 functions:build --src netlify/functions --functions .netlify/functions-verified",
    "butler:shopping": "node --env-file-if-exists=.env tools/butler-shopping.mjs",
    "owner:set-password": "node tools/set-owner-password.mjs",
    "owner:password": "node tools/owner-password.mjs",
    "test:rehearsal": "npm run build && playwright test -c playwright.rehearsal.config.ts",
    "test:screening": "npm run build && playwright test -c playwright.screening.config.ts && SCREENING_WEBKIT=1 playwright test -c playwright.screening.config.ts",
    "verify:final-migrations": "node tools/verify-final-release-migrations.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@netlify/blobs": "^11.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
