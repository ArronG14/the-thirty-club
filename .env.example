# The Thirty Club — concierge service (Netlify Functions). See docs/CONCIERGE.md.
# Set these in Netlify site settings (Functions scope). Never commit real values.
CONCIERGE_SESSION_SECRET=
CONCIERGE_OWNER_KEY=
CREDENTIAL_DEPARTURE_TOKEN=
CREDENTIAL_DEPARTURE_CODE=
CREDENTIAL_MEMBERSHIP_TOKEN=
CREDENTIAL_MEMBERSHIP_CODE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REHEARSAL_CHAT_ID=
# manual (default) or sms
ALISE_DISPATCH=manual
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=ThirtyClub
ALISE_PHONE=
ARRON_PHONE=
PRIVILEGE_IN_FLIGHT_OPENS_AT=
PRIVILEGE_JAMAICA_ARRIVAL_OPENS_AT=
CONCIERGE_SITE_URL=
# Build scope, optional offline membership fallback (node tools/membership-hash.mjs)
VITE_MEMBERSHIP_TOKEN_SHA256=
VITE_MEMBERSHIP_CODE_SHA256=

# Authoritative v1 backend (Functions scope only; never VITE_)
# Dedicated Supabase project: The Thirty Club / London
SUPABASE_URL=https://fzndcjzenodcixmuvfsb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Protected films (ADR-027): Cloudflare R2 bucket ttc-media (Functions only).
# Endpoint without the bucket: https://<account id>.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Generate with node tools/owner-password.mjs
OWNER_PASSWORD_HASH=
# Reuse the existing Messaging Service with sender THIRTYCLUB
TWILIO_MESSAGING_SERVICE_SID=
# Explicit global safety switch. Individual messages still require approval.
SMS_SENDING_ENABLED=false
# ADR-022: SMS_SENDING_ENABLED=true only makes the Twilio transport available.
# Whether anything is sent is decided by the SMS mode (OFF by default) in the
# Owner Control Centre → SMS operations, and for Alise also the communication
# hold. The owner's own verified number for REHEARSAL copies (E.164, never
# Alise's number; server-side only):
SMS_REHEARSAL_TO=
# Set to postgres only after tools/migrate-concierge.mjs verifies existing records.
# Leave blank to retain the existing Blobs concierge during migration.
CONCIERGE_LEGACY_STORAGE=

# Doja's separate letter (Functions only; never VITE_). Set in Netlify to the
# owner-approved shared password before publishing /fromdoja.
DOJA_LETTER_PASSWORD=
